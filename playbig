  resolveSession, COMMANDS, printHelp, main,
  CONFIG_FILE, SESSION_FILE,
};

if (require.main === module) {
  main().catch(err => {
    console.error(`Error: ${err.message}`);
    if (err.status) console.error(`HTTP ${err.status}`);
    process.exit(1);
  });
}
