// Network
COMMANDS['network'] = {
  usage: 'network [--since <epoch-ms>] [--url <substring>]',
  desc:  'Print network requests and responses',
  async run(config, args) {
    const id    = resolveSession(config);
    const query = {};
    const si    = args.indexOf('--since');
    const ui    = args.indexOf('--url');
    if (si >= 0 && args[si + 1]) query.since = args[si + 1];
    if (ui >= 0 && args[ui + 1]) query.url   = args[ui + 1];

    const data = await apiRequest(config, 'GET', `/sessions/${id}/network`, undefined, query);

    for (const req of data.requests) {
      console.log(`→ ${req.method.padEnd(6)} ${req.url}`);
    }
    for (const res of data.responses) {
      console.log(`← ${String(res.status).padEnd(6)} ${res.url}`);
    }
    if (!data.requests.length && !data.responses.length) console.log('No network traffic.');
    return data;
  },
};

