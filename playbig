// Logs
COMMANDS['logs'] = {
  usage: 'logs [--since <epoch-ms>] [--type <type>]',
  desc:  'Print console logs and page errors (type: log|warn|error|info|debug)',
  async run(config, args) {
    const id    = resolveSession(config);
    const query = {};
    const si    = args.indexOf('--since');
    const ti    = args.indexOf('--type');
    if (si >= 0 && args[si + 1]) query.since = args[si + 1];
    if (ti >= 0 && args[ti + 1]) query.type  = args[ti + 1];

    const data = await apiRequest(config, 'GET', `/sessions/${id}/logs`, undefined, query);

    for (const log of data.logs) {
      const ts = new Date(log.timestamp).toISOString();
      console.log(`[${ts}] [${log.type.padEnd(5)}] ${log.text}`);
    }
    for (const err of data.pageErrors) {
      const ts = new Date(err.timestamp).toISOString();
      console.log(`[${ts}] [error] ${err.message}`);
    }
    if (!data.logs.length && !data.pageErrors.length) console.log('No logs.');
    return data;
  },
};

