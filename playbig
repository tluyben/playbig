  async run(config, args) {
    if (!args[0] || !args[1]) throw new Error('Usage: playbig resize <width> <height>');
    await runAction(config, 'resize', { width: parseInt(args[0], 10), height: parseInt(args[1], 10) });
    console.log(`Viewport: ${args[0]}x${args[1]}`);
  },
};

// Dialog handling
COMMANDS['handle-dialog'] = {
  usage: 'handle-dialog [accept|dismiss] [prompt-text]',
  desc:  'Arm a one-shot handler for the NEXT dialog (alert/confirm/prompt). Call BEFORE the action that triggers it.',
  async run(config, args) {
    const response   = args[0] || 'accept';
    const promptText = args[1] != null ? args[1] : null;
    if (response !== 'accept' && response !== 'dismiss') {
      throw new Error('Usage: playbig handle-dialog [accept|dismiss] [prompt-text]');
    }
    const params = { response };
    if (promptText != null) params.promptText = promptText;
    await runAction(config, 'handleDialog', params);
    console.log(`Dialog handler armed: ${response}${promptText != null ? ` (text: "${promptText}")` : ''}`);
  },
};

COMMANDS['dialogs'] = {
  usage: 'dialogs',
  desc:  'List dialog history for the current session (last 20)',
  async run(config) {
    const res = await runAction(config, 'dialogs');
    const list = res.result.dialogs;
    if (!list.length) {
      console.log('No dialogs recorded.');
    } else {
      for (const d of list) {
        const ts = new Date(d.timestamp).toISOString();
        console.log(`[${ts}] [${d.type}] ${d.message}${d.defaultValue ? ` (default: ${d.defaultValue})` : ''}`);
      }
    }
    return res;
  },
};

// File upload
COMMANDS['upload-file'] = {
  usage: 'upload-file <selector> <filepath>',
  desc:  'Upload a local file to a <input type="file"> element',
  async run(config, args) {
    if (!args[0] || !args[1]) throw new Error('Usage: playbig upload-file <selector> <filepath>');
    const selector = args[0];
    const filepath = args[1];

    let fileContent;
    try {
      fileContent = fs.readFileSync(filepath);
    } catch (err) {
      throw new Error(`Cannot read file "${filepath}": ${err.message}`);
    }

    const name     = require('path').basename(filepath);
    const content  = fileContent.toString('base64');
    await runAction(config, 'uploadFile', { selector, name, content });
    console.log(`Uploaded: ${filepath} → ${selector}`);
  },
};

// Raw escape hatch
COMMANDS['action'] = {
  usage: 'action <action-name> [json-params]',
  desc:  'Run any action directly with raw JSON params',
  async run(config, args) {
    if (!args[0]) throw new Error('Usage: playbig action <action-name> [json-params]');
    let params = {};
    if (args[1]) {
      try { params = JSON.parse(args[1]); } catch { throw new Error('Invalid JSON for params'); }
    }
    const res = await runAction(config, args[0], params);
    print(res);
    return res;
  },
};

