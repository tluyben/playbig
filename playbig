#!/usr/bin/env node
'use strict';

/**
 * playbig — CLI for the playbig browser session management API.
 *
 * Config (~/.playbig, key=value format, or bare token):
 *   token=<access-token>
 *   url=http://localhost:3000
 *
 * Env var overrides:
 *   PLAYBIG_TOKEN=<token>
 *   PLAYBIG_URL=http://localhost:3000
 *
 * Current session ID is stored in ~/.playbig-session.
 */

const fs   = require('fs');
const path = require('path');
const os   = require('os');

const CONFIG_FILE  = path.join(os.homedir(), '.playbig');
const SESSION_FILE = path.join(os.homedir(), '.playbig-session');

// ── Config ───────────────────────────────────────────────────────────────────

function loadConfig() {
  let token   = process.env.PLAYBIG_TOKEN || '';
  let baseUrl = process.env.PLAYBIG_URL   || 'http://localhost:3000';

  if (fs.existsSync(CONFIG_FILE)) {
    const raw = fs.readFileSync(CONFIG_FILE, 'utf8').trim();
    if (raw.includes('=') || raw.includes('\n')) {
      // key=value format
      for (const line of raw.split('\n')) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const eq  = trimmed.indexOf('=');
        if (eq < 0) continue;
        const key = trimmed.slice(0, eq).trim();
        const val = trimmed.slice(eq + 1).trim();
        if (key === 'token'  && !process.env.PLAYBIG_TOKEN) token   = val;
        if (key === 'url'    && !process.env.PLAYBIG_URL)   baseUrl = val;
      }
    } else {
      // bare token on a single line
      if (!process.env.PLAYBIG_TOKEN) token = raw;
    }
  }

  return { token, baseUrl: baseUrl.replace(/\/$/, '') };
}

// ── Session state ────────────────────────────────────────────────────────────

function readSession() {
  try {
    const id = fs.readFileSync(SESSION_FILE, 'utf8').trim();
    return id || null;
  } catch {
    return null;
  }
}

function writeSession(id) {
  if (id) {
    fs.writeFileSync(SESSION_FILE, id + '\n', 'utf8');
  } else {
    try { fs.unlinkSync(SESSION_FILE); } catch {}
  }
}

// ── HTTP client ──────────────────────────────────────────────────────────────

async function apiRequest(config, method, urlPath, body, query = {}) {
  const headers = { 'Content-Type': 'application/json' };
  if (config.token) headers['Authorization'] = `Bearer ${config.token}`;

  const qs = Object.keys(query).length
    ? '?' + new URLSearchParams(query).toString()
    : '';

  const fetchOpts = { method, headers };
  if (body !== undefined) fetchOpts.body = JSON.stringify(body);

  const fullUrl = `${config.baseUrl}${urlPath}${qs}`;
  let res;
  try {
    res = await fetch(fullUrl, fetchOpts);
  } catch (err) {
    throw new Error(`Cannot connect to playbig at ${config.baseUrl}: ${err.message}`);
  }

  const text = await res.text();
  let data;
  try { data = JSON.parse(text); } catch { data = { _raw: text }; }

  if (!res.ok) {
    const msg = (data && typeof data === 'object' && data.error) ? data.error : (text || res.statusText);
    const err = new Error(msg);
    err.status = res.status;
    err.data   = data;
    throw err;
  }

  return data;
}

// ── Session resolution ────────────────────────────────────────────────────────

// Returns the session ID to use: config.session (from --session flag) > ~/.playbig-session
function resolveSession(config) {
  const id = (config && config.session) || readSession();
  if (!id) {
    console.error('No active session. Run: playbig start-session [url]');
    process.exit(1);
  }
  return id;
}

async function runAction(config, action, params = {}) {
  const id = resolveSession(config);
  return apiRequest(config, 'POST', `/sessions/${id}/action`, { action, params });
}

// ── Output ───────────────────────────────────────────────────────────────────

function print(data) {
  if (typeof data === 'string') {
    process.stdout.write(data + '\n');
  } else {
    process.stdout.write(JSON.stringify(data, null, 2) + '\n');
  }
}

// ── Commands ──────────────────────────────────────────────────────────────────

const COMMANDS = {};

// Session management
COMMANDS['start-session'] = {
  usage: 'start-session [url]',
  desc:  'Create a new browser session (ends any existing session first)',
  async run(config, args) {
    const existing = readSession();
    if (existing) {
      try {
        await apiRequest(config, 'DELETE', `/sessions/${existing}`);
        console.error(`Ended previous session: ${existing}`);
      } catch { /* ignore — session may already be gone */ }
      writeSession(null);
    }

    const startUrl = args[0];
    const body = startUrl ? { url: startUrl } : {};
    const session = await apiRequest(config, 'POST', '/sessions', body);
    writeSession(session.id);
    console.log(`Session started: ${session.id}`);
    if (session.startUrl) console.log(`URL: ${session.startUrl}`);
    return session;
  },
};

COMMANDS['end-session'] = {
  usage: 'end-session [session-id]',
  desc:  'End the current (or specified) session',
  async run(config, args) {
    const id = args[0] || resolveSession(config);
    await apiRequest(config, 'DELETE', `/sessions/${id}`);
    if (!args[0] || args[0] === readSession()) writeSession(null);
    console.log(`Session ended: ${id}`);
  },
};

COMMANDS['sessions'] = {
  usage: 'sessions',
  desc:  'List all active sessions (* marks the current one)',
  async run(config) {
    const data    = await apiRequest(config, 'GET', '/sessions');
    const current = readSession();
    if (!data.sessions.length) {
      console.log('No active sessions.');
    } else {
      for (const s of data.sessions) {
        const marker = s.id === current ? '*' : ' ';
        const age = Math.round(s.ageMs / 1000);
        console.log(`${marker} ${s.id}  status=${s.status}  age=${age}s  url=${s.startUrl || '(none)'}`);
      }
    }
    return data;
  },
};

COMMANDS['status'] = {
  usage: 'status [session-id]',
  desc:  'Show session metadata (defaults to current session)',
  async run(config, args) {
    const id   = args[0] || resolveSession(config);
    const data = await apiRequest(config, 'GET', `/sessions/${id}`);
    print(data);
    return data;
  },
};

