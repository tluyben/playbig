// ── Main ──────────────────────────────────────────────────────────────────────

async function main(argv) {
  argv = argv || process.argv;
  let args = argv.slice(2);

  // Extract global --session <id> flag (may appear anywhere before the command)
  let sessionOverride = null;
  const si = args.indexOf('--session');
  if (si >= 0 && args[si + 1] && !args[si + 1].startsWith('-')) {
    sessionOverride = args[si + 1];
    args = [...args.slice(0, si), ...args.slice(si + 2)];
  }

  const [cmd, ...cmdArgs] = args;

  if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
    printHelp();
    return;
  }

  const command = COMMANDS[cmd];
  if (!command) {
    console.error(`Unknown command: ${cmd}`);
    console.error('Run `playbig help` for usage.');
    process.exit(1);
  }

  const config = { ...loadConfig(), session: sessionOverride };
  await command.run(config, cmdArgs);
}

