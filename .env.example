# Server
PORT=3000

# Session limits
# Max age for a session in milliseconds (0 = unlimited)
MAX_SESSION_AGE_MS=0

# Max number of console log entries kept per session (ring buffer)
MAX_CONSOLE_LOGS=1000

# Max number of network entries (requests + responses) kept per session (ring buffer)
MAX_NETWORK_ENTRIES=1000

# Max response body buffered in memory per network entry (bytes). Default 1 MB.
# Bodies larger than this still record bodySize (from content-length header) but body will be null.
MAX_RESPONSE_BODY_BYTES=1048576

# Monitor
# How often the watchdog checks sessions (milliseconds)
MONITOR_INTERVAL_MS=10000

# Leader / slave mode
# Set to "true" on the leader node
LEADER_MODE=false

# Comma-separated list of slave URLs the leader round-robins across
# The leader itself is included in the pool unless FORWARD_INCLUDE_SELF=false
# SLAVE_URLS=http://slave1:3000,http://slave2:3000
SLAVE_URLS=

# Set to "false" to exclude the leader itself from the round-robin pool
FORWARD_INCLUDE_SELF=true
