# Server
PORT=3000

# Session limits
# Max age for a session in milliseconds (0 = unlimited)
MAX_SESSION_AGE_MS=0

# Max number of console log entries kept per session (ring buffer)
MAX_CONSOLE_LOGS=1000

# Max number of network entries (requests + responses) kept per session (ring buffer)
MAX_NETWORK_ENTRIES=1000

# Max response body buffered in memory per network entry (bytes). Default 1 MB.
# Bodies larger than this still record bodySize (from content-length header) but body will be null.
MAX_RESPONSE_BODY_BYTES=1048576

# Monitor
# How often the watchdog checks sessions (milliseconds)
MONITOR_INTERVAL_MS=10000

# ── Follower routing (load distribution) ──────────────────────────────────────
#
# Set FOLLOWERS to enable leader mode. The leader distributes new session
# creation across the follower nodes + itself in round-robin order and
# transparently routes all subsequent requests to the correct node.
#
# Format: comma-separated host:port pairs (or full http:// URLs)
#
# Example (two followers):
#   FOLLOWERS=worker1:3001,worker2:3002
#
# Start the followers first (plain STANDALONE nodes with no FOLLOWERS set),
# then start the leader with FOLLOWERS pointing at them.
#
# The client only ever needs the leader URL. Responses include an
# x-playbig-node header indicating which node handled the request.
FOLLOWERS=
